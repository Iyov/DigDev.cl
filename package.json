{
  "name": "digdev-solutions",
  "version": "2026-02-08_4",
  "description": "DigDev Solutions - Sitio web optimizado para la industria minera",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.min.css --watch",
    "minify:css": "cleancss -o css/index.min.css css/index.css",
    "minify:js": "terser js/index.js -c -m -o js/index.min.js",
    "minify": "npm run minify:css && npm run minify:js",
    "watch:assets": "onchange \"css/index.css\" \"js/index.js\" -- npm run minify",
    "dev": "npm run watch:assets",
    "prepare": "npm run minify"
  },
  "keywords": [
    "mining",
    "software",
    "solutions"
  ],
  "author": "DigDev Solutions",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.17.0",
    "clean-css-cli": "^5.3.0",
    "onchange": "^7.1.0"
  }
}
